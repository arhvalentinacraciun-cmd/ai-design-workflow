{
  "guardrail-no-hardcoding": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/scan-hardcoded.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
